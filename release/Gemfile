# frozen_string_literal: true

# Dependencies for the release-tool tests (test/test_prepare_release.rb).
# The SDK itself has its own separate Gemfile in temporalio/.
#
# Usage (from the release/ directory):
#   bundle install
#   bundle exec ruby test/test_prepare_release.rb

source 'https://rubygems.org'

group :test do
  gem 'minitest'
  # minitest 6.x (bundled with Ruby 3.3+) extracted mock into its own gem.
  gem 'minitest-mock'
end
