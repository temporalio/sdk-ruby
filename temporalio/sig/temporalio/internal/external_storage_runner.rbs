module Temporalio
  module Internal
    class ExternalStorageRunner
      @storage: Converters::ExternalStorage?
      @namespace: String?
      @clock: ^() -> Float

      MONOTONIC_CLOCK: ^() -> Float

      def initialize: (Converters::ExternalStorage? storage, namespace: String?, ?clock: ^() -> Float) -> void

      def store: (
        Array[Api::Common::V1::Payload] payloads,
        ?target: Converters::storageDriverTargetInfo?,
        ?metrics: StorageOperationMetrics?
      ) -> Array[Api::Common::V1::Payload]
      def retrieve: (
        Array[Api::Common::V1::Payload] payloads,
        ?metrics: StorageOperationMetrics?
      ) -> Array[Api::Common::V1::Payload]

      private def raise_as_storage_error: [T] (String failure_message) { () -> T } -> T
      private def check_driver_result: (
        Converters::StorageDriver driver,
        String operation,
        Integer requested,
        untyped returned,
        Class expected_item_class
      ) -> void
    end
  end
end
