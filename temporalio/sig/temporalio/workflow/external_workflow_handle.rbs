module Temporalio
  module Workflow
    class ExternalWorkflowHandle
      def id: -> String
      def run_id: -> String?

      def signal: (
        Workflow::Definition::Signal | Symbol | String signal,
        *Object? args,
        ?cancellation: Cancellation,
        ?arg_hints: Array[Object]?,
        ?event_groups: Array[EventGroup]?
      ) -> void

      def cancel: (?event_groups: Array[EventGroup]?) -> void
    end
  end
end