module Temporalio
  module Converters
    class StorageDriverSelectContext
      attr_reader target: storageDriverTargetInfo?
      attr_reader cancellation: Cancellation
      attr_reader namespace: String?

      def initialize: (
        target: storageDriverTargetInfo?,
        cancellation: Cancellation,
        ?namespace: String?
      ) -> void
    end
  end
end
