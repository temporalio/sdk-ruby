module Temporalio
  module Converters
    class StorageDriverStoreContext
      attr_reader target: storageDriverTargetInfo?
      attr_reader cancellation: Cancellation
      attr_reader limiter: StorageDriverLimiter

      def initialize: (
        target: storageDriverTargetInfo?,
        cancellation: Cancellation,
        limiter: StorageDriverLimiter
      ) -> void
    end
  end
end
