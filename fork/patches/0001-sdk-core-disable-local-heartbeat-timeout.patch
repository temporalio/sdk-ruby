+    // With the local heartbeat timer disabled, an activity that never heartbeats through this worker is not timed out
+    // locally, however long its heartbeat timeout has elapsed: only the server enforces it.
+    #[tokio::test]
+    async fn local_heartbeat_timeout_can_be_disabled() {
+        let mut mock_client = mock_worker_client();
+        mock_client
+            .expect_poll_activity_task()
+            .times(1)
+            .returning(move |_, _| {
+                Ok(PollActivityTaskQueueResponse {
+                    task_token: vec![1],
+                    activity_id: "act1".to_string(),
+                    heartbeat_timeout: Some(prost_dur!(from_millis(100))),
+                    ..Default::default()
+                })
+            });
+        mock_client // We can end up polling again - just return nothing.
+            .expect_poll_activity_task()
+            .returning(|_, _| Ok(Default::default()));
+        let mock_client = Arc::new(mock_client);
+        let atm = build_local_timeout_test_atm(mock_client.clone(), Duration::from_millis(0), true);
+
+        let t = atm.poll().await.unwrap();
+        // Six times the heartbeat timeout. With the timer enabled the timeout cancel would have arrived by now.
+        assert!(
+            tokio::time::timeout(Duration::from_millis(600), atm.poll())
+                .await
+                .is_err(),
+            "the activity was timed out locally"
+        );
+
+        atm.complete(
+            t.task_token.into(),
+            ActivityExecutionResult::will_complete_async()
+                .status
+                .unwrap(),
+            mock_client.as_ref(),
+        )
+        .await;
+        atm.initiate_shutdown();
+        assert_matches!(atm.poll().await.unwrap_err(), PollError::ShutDown);
+        atm.shutdown().await;
+    }
+
+    // Disabling the local heartbeat timer leaves the local start_to_close timer alone.
+    #[tokio::test]
+    async fn disabling_local_heartbeat_timeout_keeps_start_to_close() {
+        let mut mock_client = mock_worker_client();
+        mock_client
+            .expect_poll_activity_task()
+            .times(1)
+            .returning(move |_, _| {
+                Ok(PollActivityTaskQueueResponse {
+                    task_token: vec![1],
+                    activity_id: "act1".to_string(),
+                    start_to_close_timeout: Some(prost_dur!(from_millis(300))),
+                    heartbeat_timeout: Some(prost_dur!(from_millis(100))),
+                    ..Default::default()
+                })
+            });
+        mock_client
+            .expect_poll_activity_task()
+            .returning(|_, _| Ok(Default::default()));
+        let mock_client = Arc::new(mock_client);
+        let atm = build_local_timeout_test_atm(mock_client.clone(), Duration::from_millis(0), true);
+
+        let t = atm.poll().await.unwrap();
+        let start = Instant::now();
+        let timed_out = tokio::time::timeout(Duration::from_secs(2), atm.poll())
+            .await
+            .expect("start_to_close_timeout was not enforced locally")
+            .unwrap();
+        assert!(timed_out.is_timeout());
+        // It was the 300ms start_to_close timer, not the (disabled) 100ms heartbeat timer.
+        assert!(start.elapsed() >= Duration::from_millis(250));
+
+        atm.complete(
+            t.task_token.into(),
+            ActivityExecutionResult::fail("unimportant".into())
+                .status
+                .unwrap(),
+            mock_client.as_ref(),
+        )
+        .await;
+        atm.initiate_shutdown();
+        assert_matches!(atm.poll().await.unwrap_err(), PollError::ShutDown);
+        atm.shutdown().await;
+    }
