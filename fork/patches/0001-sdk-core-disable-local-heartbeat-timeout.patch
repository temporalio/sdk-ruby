     #[builder(default = Duration::from_secs(5))]
     pub local_timeout_buffer_for_activities: Duration,
 
+    /// If true, core does not use its own heartbeat timer to time out activities.
+    ///
+    /// By default it does: when no heartbeat recorded through this worker has been acknowledged for an
+    /// activity's heartbeat timeout plus [WorkerConfig::local_timeout_buffer_for_activities], core
+    /// cancels the activity as timed out and discards its result, since the server is assumed to have
+    /// timed it out too. Heartbeats sent some other way (for example by ID from another process, so that
+    /// a long native call holding the language's global lock cannot starve them) reach the server but
+    /// not this worker, so the activity is cancelled while the server still considers it alive and its
+    /// finished result is lost. Set this to leave heartbeat timeouts to the server alone. The local
+    /// start-to-close timer is unaffected.
+    #[builder(default = false)]
+    pub disable_local_heartbeat_timeout_for_activities: bool,
+
     /// Any error types listed here will cause any workflow being processed by this worker to fail,
     /// rather than simply failing the workflow task.
     #[builder(default)]
